{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CrawlTaskConfig",
  "type": "object",
  "required": [
    "source_id",
    "query"
  ],
  "properties": {
    "source_id": {
      "type": "string"
    },
    "query": {
      "type": "string"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200,
      "default": 50
    },
    "region": {
      "type": [
        "string",
        "null"
      ]
    },
    "keyword_group": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}