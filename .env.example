APP_ENV=development
APP_NAME=LeadRadar
DATABASE_URL=postgresql+psycopg://leadradar:leadradar@localhost:5432/leadradar
REDIS_URL=redis://localhost:6379/0

# LLM provider: openai-compatible, anthropic, mock
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=mock-extractor

# Crawling limits
CRAWL_USER_AGENT=LeadRadarBot/0.1 (+contact@example.com)
CRAWL_REQUESTS_PER_MINUTE=30
CRAWL_TIMEOUT_SECONDS=20

# Compliance switches
ALLOW_PUBLIC_BUSINESS_CONTACTS=true
ALLOW_PERSONAL_PHONE_COLLECTION=false
ALLOW_AUTOMATED_OUTBOUND_CALLS=false
